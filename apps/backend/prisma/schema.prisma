// This is your Prisma schema file — source of truth for the DB schema.
// Run `yarn db:generate` after any change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String
  passwordHash           String
  refreshTokenHash       String?
  refreshTokenExpiresAt  DateTime?
  avatarUrl              String?
  dateOfBirth            DateTime?
  gender                 String?
  heightCm               Float?
  fcmToken               String?   // Firebase Cloud Messaging device token
  createdAt              DateTime  @default(now())

  profile             UserProfile?
  foodLogs            FoodLog[]
  workoutLogs         WorkoutLog[]
  bodyStats           BodyStat[]
  goals               Goal[]
  subscription        Subscription?
  wearableConnections WearableConnection[]

  // Community
  adminOfCommunities    Community[]            @relation("CommunityAdmin")
  communityMemberships  CommunityMember[]
  communityMessages     CommunityMessage[]
  challengesCreated     Challenge[]
  challengeParticipants ChallengeParticipant[]
  todoItems             TodoItem[]
  blocksMade            CommunityBlock[]       @relation("Blocker")
  blocksReceived        CommunityBlock[]       @relation("Blocked")
  reportsMade           CommunityReport[]
}


model UserProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  fitnessGoal    String // lose_weight | build_muscle | maintain | endurance
  activityLevel  String // sedentary | light | moderate | active | very_active
  targetWeightKg Float?
  tdee           Int?   // calculated total daily energy expenditure

  user User @relation(fields: [userId], references: [id])
}

model FoodLog {
  id       String   @id @default(cuid())
  userId   String
  foodId   String   // references food database
  foodName String
  mealType String   // breakfast | lunch | dinner | snack
  servingG Float
  calories Float
  proteinG Float
  carbsG   Float
  fatG     Float
  fiberG   Float?
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model WorkoutLog {
  id             String    @id @default(cuid())
  userId         String
  name           String
  startedAt      DateTime
  finishedAt     DateTime?
  durationMin    Int?
  caloriesBurned Int?
  notes          String?
  distanceM      Float?    // total GPS distance in metres (outdoor workouts only)
  routePolyline  String?   // Google Encoded Polyline string for the GPS route

  user User          @relation(fields: [userId], references: [id])
  sets ExerciseSet[]
}

model ExerciseSet {
  id           String @id @default(cuid())
  workoutLogId String
  exerciseId   String
  exerciseName String
  setNumber    Int
  reps         Int?
  weightKg     Float?
  durationSec  Int?   // for time-based exercises
  distanceM    Float? // for cardio
  rpe          Int?   // rate of perceived exertion 1-10

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id])
}

model BodyStat {
  id           String   @id @default(cuid())
  userId       String
  weightKg     Float?
  bodyFatPct   Float?
  muscleMassKg Float?
  bmi          Float?
  measuredAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  type         String    // daily_calories | weekly_workouts | steps | weight_target
  targetValue  Float
  currentValue Float     @default(0)
  deadline     DateTime?
  completed    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  tier             String    // free | pro | coach
  stripeId         String?   // Stripe subscription ID
  stripeCustomerId String?   @unique
  stripePriceId    String?
  googlePlayToken  String?   @unique // binds a Play purchase to exactly one account
  validUntil       DateTime?

  user User @relation(fields: [userId], references: [id])
}

model WearableConnection {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // fitbit | garmin | whoop | oura
  accessToken String
  refreshToken String?
  expiresAt   DateTime?
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
}

// ─── Community ────────────────────────────────────────────────────────────────

model Community {
  id               String   @id @default(cuid())
  name             String
  nameLower        String   @unique // case-insensitive uniqueness + search
  description      String?
  avatarUrl        String?
  adminId          String
  isPublic         Boolean  @default(true) // appears in name search
  requireApproval  Boolean  @default(false)
  membersCanChat   Boolean  @default(true)
  membersCanInvite Boolean  @default(true)
  inviteCode       String   @unique
  createdAt        DateTime @default(now())

  admin      User               @relation("CommunityAdmin", fields: [adminId], references: [id])
  members    CommunityMember[]
  messages   CommunityMessage[]
  challenges Challenge[]

  @@index([adminId])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  role        String    @default("member")  // admin | member
  status      String    @default("active")  // pending | active | on_hold | left
  shareReport Boolean   @default(false)     // consent: admin may see fitness report + challenges
  consentAt   DateTime?
  heldAt      DateTime?
  leftAt      DateTime?
  joinedAt    DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityMessage {
  id          String    @id @default(cuid())
  communityId String
  authorId    String
  kind        String    // text | update | media | notepad_share | challenge_event
  body        String?
  mediaPath   String?   // object path in the media bucket
  mediaType   String?   // image | video | document
  mediaName   String?
  replyToId   String?
  payload     Json?     // notepad snapshot / challenge card
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
}

model Challenge {
  id          String   @id @default(cuid())
  communityId String?  // null = personal challenge, owned by the user alone
  creatorId   String
  kind        String   // personal | group
  title       String
  description String   @default("")
  totalDays   Int
  status      String   @default("open") // open | closed
  createdAt   DateTime @default(now())

  community    Community?             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator      User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@index([communityId])
}

// One row per person doing a challenge (personal challenge = exactly one row).
model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  startDate   DateTime @db.Date // the user's local calendar date when they started
  notes       String   @default("") // this person's notepad
  status      String   @default("active") // active | completed | abandoned

  challenge Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins  ChallengeCheckin[]
  dayNotes  ChallengeDayNote[]

  @@unique([challengeId, userId])
  @@index([userId])
}

// One notepad sheet per challenge day, per participant (private to its owner).
model ChallengeDayNote {
  id            String   @id @default(cuid())
  participantId String
  dayNumber     Int
  notes         String   @default("")
  updatedAt     DateTime @updatedAt

  participant ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, dayNumber])
}

model ChallengeCheckin {
  id            String   @id @default(cuid())
  participantId String
  dayNumber     Int
  date          DateTime @db.Date
  completedAt   DateTime @default(now())

  participant ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, dayNumber])
}

// Private daily to-do list. Only ever returned to its owner.
model TodoItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  done        Boolean  @default(false)
  repeatDaily Boolean  @default(false) // root of a repeating item
  templateId  String?  // set on the per-day copies of a repeating root
  hidden      Boolean  @default(false) // tombstone for a deleted per-day copy
  forDate     DateTime @db.Date
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, forDate])
  @@index([userId, forDate])
}

model CommunityBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model CommunityReport {
  id          String   @id @default(cuid())
  reporterId  String
  messageId   String?
  communityId String?
  userId      String?
  reason      String
  createdAt   DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}
